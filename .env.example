# docker-compose.yml 이 읽는 값. 서버의 ~/cogom/.env 는 GitHub Actions 가 Secrets 로부터 생성한다.
# 로컬에서 쓸 때만 이 파일을 .env 로 복사해 채운다. .env 는 커밋하지 않는다.

# 서버에서는 CI가 ghcr.io/<owner>/<repo>:<commit sha> 로 채운다. 로컬 빌드는 비워 둔다.
APP_IMAGE=

DB_NAME=cogom
DB_USER=cogom
# openssl rand -hex 24
DB_PASSWORD=
# openssl rand -base64 48  (디코딩 시 32바이트 이상인 표준 Base64)
JWT_SECRET=

# 다른 출처에서 접속하는 프런트엔드 주소. 쉼표로 여러 개 지정할 수 있다. 예) https://cogom.vercel.app
ALLOWED_ORIGINS=

# 외부에 직접 열 때 0.0.0.0, Nginx 뒤에 둘 때 127.0.0.1
APP_BIND=0.0.0.0
APP_PORT=8080
